PORT=3000
HOST=127.0.0.1
DB_PATH=data/app.db
NODE_ENV=production
SESSION_SECRET=请改成一段随机长字符串
COOKIE_SECURE=true

# App 壳跨域来源（Capacitor 安卓 WebView 默认 https://localhost），多个用英文逗号分隔；留空关闭跨域
CORS_ORIGIN=
# App 跨站会话 Cookie（仅 HTTPS 下生效，会自动加上 Secure）
COOKIE_CROSS_SITE=false

# 管理员手机号，多个用英文逗号分隔
ADMIN_PHONES=13800000000

# 短信服务：开发/测试用 mock，正式部署改成 aliyun
SMS_PROVIDER=mock
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SIGN_NAME=
ALIYUN_TEMPLATE_CODE=
ALIYUN_TEMPLATE_PARAM=code

# 可选的整站访问口令，留空表示关闭
ACCESS_PASSWORD=
